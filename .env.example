# Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# Database (if using real database in production)
# DATABASE_URL=postgresql://user:password@localhost:5432/accredian

# API Configuration
# API_SECRET=your_secret_key_here

# Email Service (if implementing email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASS=your_password

# CRM Integration (if connecting to external CRM)
# CRM_API_KEY=your_crm_api_key
# CRM_API_URL=https://api.crm-provider.com

# Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Note: NEXT_PUBLIC_ prefix makes variables accessible in the browser
# Keep sensitive keys without this prefix for server-only access
